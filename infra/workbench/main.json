{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "12711653222526474841"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the workbench resources."
      }
    },
    "workloadToken": {
      "type": "string",
      "defaultValue": "ofmfleet",
      "minLength": 3,
      "maxLength": 10,
      "metadata": {
        "description": "Short lowercase alphanumeric workload token used in resource names."
      }
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "staging",
        "prod"
      ],
      "metadata": {
        "description": "Deployment environment tag and resource-name segment."
      }
    },
    "foundryAccountName": {
      "type": "string",
      "metadata": {
        "description": "Existing Microsoft Foundry account name."
      }
    },
    "foundryProjectName": {
      "type": "string",
      "metadata": {
        "description": "Existing Microsoft Foundry project name."
      }
    },
    "foundryAgentEndpoint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Exact hosted-agent Responses endpoint. Leave empty during the foundation deployment."
      }
    },
    "containerImage": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Container image to deploy after it has been built in this stack Azure Container Registry."
      }
    },
    "deployWorkbench": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Whether to deploy the workbench Container App. The foundation deployment leaves this false."
      }
    },
    "entraClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Single-tenant Entra application client ID used by Container Apps authentication."
      }
    },
    "operatorPrincipalObjectIds": {
      "type": "array",
      "minLength": 1,
      "metadata": {
        "description": "Microsoft Entra object IDs allowed to use the confidential migration workbench."
      }
    },
    "entraClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Entra application credential consumed only by the Container Apps authentication provider."
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[take(uniqueString(resourceGroup().id), 8)]",
    "environmentToken": "[take(parameters('environmentName'), 3)]",
    "compactToken": "[take(parameters('workloadToken'), 7)]",
    "registryName": "[format('acr{0}{1}{2}', variables('compactToken'), variables('environmentToken'), variables('uniqueSuffix'))]",
    "identityName": "[format('id-{0}-web-{1}-{2}', parameters('workloadToken'), parameters('environmentName'), variables('uniqueSuffix'))]",
    "workspaceName": "[format('log-{0}-web-{1}-{2}', parameters('workloadToken'), parameters('environmentName'), variables('uniqueSuffix'))]",
    "insightsName": "[format('appi-{0}-web-{1}-{2}', parameters('workloadToken'), parameters('environmentName'), variables('uniqueSuffix'))]",
    "managedEnvironmentName": "[format('cae-{0}-{1}-{2}', parameters('workloadToken'), parameters('environmentName'), variables('uniqueSuffix'))]",
    "workbenchName": "[format('ca-{0}-{1}-{2}', parameters('workloadToken'), parameters('environmentName'), variables('uniqueSuffix'))]",
    "imageRepository": "migration-fleet-workbench",
    "authSecretName": "microsoft-provider-authentication-secret",
    "acrPullRoleId": "7f951dda-4ed3-4680-a7ca-43fe172d538d",
    "foundryAgentConsumerRoleId": "eed3b665-ab3a-47b6-8f48-c9382fb1dad6",
    "tags": {
      "workload": "oracle-forms-migration-fleet",
      "environment": "[parameters('environmentName')]",
      "managed-by": "bicep",
      "data-classification": "confidential"
    }
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('identityName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[variables('registryName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false,
        "dataEndpointEnabled": false,
        "networkRuleBypassOptions": "AzureServices",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), variables('acrPullRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrPullRoleId'))]",
        "description": "Workbench identity can pull its application image."
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('foundryAccountName'), parameters('foundryProjectName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('foundryAccountName'), parameters('foundryProjectName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), variables('foundryAgentConsumerRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('foundryAgentConsumerRoleId'))]",
        "description": "Workbench identity can invoke hosted agents in this Foundry project."
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('workspaceName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "features": {
          "disableLocalAuth": true,
          "enableLogAccessUsingOnlyResourcePermissions": true
        },
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled",
        "retentionInDays": 30,
        "sku": {
          "name": "PerGB2018"
        },
        "workspaceCapping": {
          "dailyQuotaGb": 1
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('insightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "tags": "[variables('tags')]",
      "properties": {
        "Application_Type": "web",
        "DisableIpMasking": false,
        "Flow_Type": "Bluefield",
        "IngestionMode": "LogAnalytics",
        "RetentionInDays": 30,
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2025-01-01",
      "name": "[variables('managedEnvironmentName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName')), '2023-09-01').primarySharedKey]"
          }
        },
        "zoneRedundant": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
      ]
    },
    {
      "condition": "[parameters('deployWorkbench')]",
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2025-01-01",
      "name": "[variables('workbenchName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('managedEnvironmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "allowInsecure": false,
            "external": true,
            "targetPort": 8088,
            "transport": "auto"
          },
          "registries": [
            {
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]",
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), '2023-07-01').loginServer]"
            }
          ],
          "secrets": [
            {
              "name": "[variables('authSecretName')]",
              "value": "[parameters('entraClientSecret')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "workbench",
              "image": "[parameters('containerImage')]",
              "env": [
                {
                  "name": "PORT",
                  "value": "8088"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').clientId]"
                },
                {
                  "name": "FOUNDRY_AGENT_ENDPOINT",
                  "value": "[parameters('foundryAgentEndpoint')]"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "value": "[reference(resourceId('Microsoft.Insights/components', variables('insightsName')), '2020-02-02').ConnectionString]"
                },
                {
                  "name": "WORKBENCH_ENTRA_AUTH_ENABLED",
                  "value": "true"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/readiness",
                    "port": 8088,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/readiness",
                    "port": 8088,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10
                }
              ],
              "resources": {
                "cpu": "[json('1.0')]",
                "memory": "2Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('insightsName'))]",
        "[resourceId('Microsoft.App/managedEnvironments', variables('managedEnvironmentName'))]",
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ]
    },
    {
      "condition": "[parameters('deployWorkbench')]",
      "type": "Microsoft.App/containerApps/authConfigs",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}', variables('workbenchName'), 'current')]",
      "properties": {
        "globalValidation": {
          "excludedPaths": [
            "/readiness"
          ],
          "redirectToProvider": "azureactivedirectory",
          "unauthenticatedClientAction": "RedirectToLoginPage"
        },
        "httpSettings": {
          "requireHttps": true
        },
        "identityProviders": {
          "azureActiveDirectory": {
            "registration": {
              "clientId": "[parameters('entraClientId')]",
              "clientSecretSettingName": "[variables('authSecretName')]",
              "openIdIssuer": "[format('{0}{1}/v2.0', environment().authentication.loginEndpoint, tenant().tenantId)]"
            },
            "validation": {
              "allowedAudiences": [
                "[parameters('entraClientId')]",
                "[format('api://{0}', parameters('entraClientId'))]"
              ],
              "defaultAuthorizationPolicy": {
                "allowedPrincipals": {
                  "identities": "[parameters('operatorPrincipalObjectIds')]"
                }
              }
            }
          }
        },
        "login": {
          "tokenStore": {
            "enabled": false
          }
        },
        "platform": {
          "enabled": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', variables('workbenchName'))]"
      ]
    }
  ],
  "outputs": {
    "registryName": {
      "type": "string",
      "value": "[variables('registryName')]"
    },
    "registryLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), '2023-07-01').loginServer]"
    },
    "imageRepository": {
      "type": "string",
      "value": "[variables('imageRepository')]"
    },
    "foundryAccountName": {
      "type": "string",
      "value": "[parameters('foundryAccountName')]"
    },
    "foundryProjectName": {
      "type": "string",
      "value": "[parameters('foundryProjectName')]"
    },
    "workbenchIdentityName": {
      "type": "string",
      "value": "[variables('identityName')]"
    },
    "workbenchIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').clientId]"
    },
    "workbenchIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]"
    },
    "containerAppEnvironmentName": {
      "type": "string",
      "value": "[variables('managedEnvironmentName')]"
    },
    "containerAppName": {
      "type": "string",
      "value": "[variables('workbenchName')]"
    },
    "workbenchFqdn": {
      "type": "string",
      "value": "[format('{0}.{1}', variables('workbenchName'), reference(resourceId('Microsoft.App/managedEnvironments', variables('managedEnvironmentName')), '2025-01-01').defaultDomain)]"
    },
    "workbenchUrl": {
      "type": "string",
      "value": "[format('https://{0}.{1}', variables('workbenchName'), reference(resourceId('Microsoft.App/managedEnvironments', variables('managedEnvironmentName')), '2025-01-01').defaultDomain)]"
    },
    "applicationInsightsName": {
      "type": "string",
      "value": "[variables('insightsName')]"
    }
  }
}