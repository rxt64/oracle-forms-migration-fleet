<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>oracle-forms-migration-fleet</AssemblyName>
    <RootNamespace>OracleFormsMigrationFleet</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ClientAppRoot>$(MSBuildProjectDirectory)\ClientApp</ClientAppRoot>
    <!-- NU1903: suppress package vulnerability audit warnings for preview/alpha packages from the azure-sdk-for-net feed.
         NU1605: suppress downgrade warnings that arise from preview transitive dependency resolution. -->
    <NoWarn>$(NoWarn);NU1903;NU1605</NoWarn>
    <UserSecretsId>7f1f7b1f-c38f-4966-9753-db5453072726</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Agent Framework hosting — provides AgentHost, AddFoundryResponses, MapFoundryResponses -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.15.0-preview.260722.1" />
    <!-- Azure OpenAI client — model inference through the account endpoint -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <!-- AIFunctionFactory — exposes the deterministic fleet to the model as tools -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <!-- .env file support for local development -->
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ClientAppSource Include="ClientApp\src\**\*;ClientApp\tests\**\*;ClientApp\index.html;ClientApp\package.json;ClientApp\package-lock.json;ClientApp\tsconfig*.json;ClientApp\vite.config.ts;ClientApp\playwright.config.ts" />
  </ItemGroup>

  <ItemGroup>
    <!-- Application templates the generators emit. Embedded so nothing is read from the repository at run time. -->
    <EmbeddedResource Include="Fleet\Execution\Templates\Northstar\*" />
  </ItemGroup>

  <Target Name="BuildClientApp" BeforeTargets="Build;Publish" Inputs="@(ClientAppSource)" Outputs="$(ClientAppRoot)\.build-stamp" Condition="'$(SkipClientBuild)' != 'true' and Exists('$(ClientAppRoot)\node_modules')">
    <Exec Command="npm run build" WorkingDirectory="$(ClientAppRoot)" />
  </Target>

</Project>
