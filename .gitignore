# azd environment — endpoints and secrets, never commit
.azure
infra/workbench/dev.json
infra/workbench/main.json

# Local environment files — never commit
.env
.env.local
*.env.local

# .NET build output
bin/
obj/
artifacts/
TestResults/

# Front-end dependencies and TypeScript build state
**/node_modules/
**/*.tsbuildinfo
**/.build-stamp

# Generated client bundle. Rebuilt by the csproj BuildClient target and by the Docker client stage,
# so committing it would only produce minified merge conflicts on every pull request.
src/oracle-forms-migration-fleet/wwwroot/

# Built output of the generated demo client. The Docker and CI stages rebuild it from the generated
# sources, so committing it would let a stale bundle contradict what the generator produces.
demo/northstar-migrated/frontend/dist/

# Maven build output of the generated demo back end, produced by `mvn test` or `mvn package`.
demo/northstar-migrated/backend/target/

# .NET user secrets
**/.secrets/

# Local agent host checkpoints — local state, never evidence
**/.checkpoints/

# IDE
.vs/
*.user
*.suo
.idea/
