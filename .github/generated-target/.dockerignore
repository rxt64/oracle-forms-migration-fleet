# Ignore everything in the generated tree that could carry a build instruction, a build output, or a
# credential into the image. The generated tree is untrusted input: only its source is wanted, never its
# packaging or tooling. Patterns are scoped to `app/` so the host-owned recipe at the context root, which
# is not part of the artifact, is unaffected.
app/**/Dockerfile
app/**/dockerfile
app/**/.dockerignore
app/**/.git
app/**/.github
app/**/node_modules
app/**/bin
app/**/obj
app/frontend/dist
app/**/.env
app/**/.env.*
app/**/*.pfx
app/**/*.pem
app/**/*.key
app/deploy
